# Always-on streamable-http deployment template. Copy and customize locally:
#   cp compose.yml.example compose.yml      # compose.yml is gitignored (per-deployment)
#   docker compose pull && docker compose up -d
# Images are built and pushed to GHCR by .github/workflows/build.yml.
# (No GHCR? Replace the image: line with "build: ." to build from this folder instead.)
services:
  template-mcp:
    image: ghcr.io/0x3e4/template-mcp:latest
    container_name: template-mcp          # stable name: reachable at http://template-mcp:8000/mcp by the gateway and other containers
    env_file: ./template.env
    environment:
      MCP_TRANSPORT: streamable-http
      MCP_HOST: 0.0.0.0           # bind all interfaces (required for the published port / gateway to reach it)
      MCP_PORT: "8000"
      MCP_ALLOWED_HOSTS: "template-mcp:8000,localhost:*,127.0.0.1:*"   # Host header values clients use (DNS-rebinding protection)
      # MCP_AUTH_TOKEN goes into the env file (and the same token into the gateway / client)
    # Localhost / single server: publish the port. Drop this block when fronting with a gateway.
    ports:
      - "8000:8000"
    restart: unless-stopped
    # --- hardening: read-only root fs, no Linux capabilities, no privilege escalation, bounded resources.
    #     Files the server writes (exports, token cache) go to a mounted volume; /tmp is a tmpfs.
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 512m
    cpus: 1.0
    # --- MCP gateway (e.g. mcpjungle): remove the ports: above and join a shared network ---
    # networks: [atlas-net]
# networks:
#   atlas-net:
#     external: true
