# Copy to template.env and fill in. Never commit real secrets.

# --- upstream API (required) ---
TEMPLATE_BASE_URL=https://api.example.com
TEMPLATE_API_KEY=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (needs a credential with
# write rights).
TEMPLATE_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
TEMPLATE_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- advanced / optional ---
# httpx request timeout in seconds.
TEMPLATE_TIMEOUT=30

# Default row cap for shaped (non-full) results.
TEMPLATE_MAX_ROWS=200

# TLS verification. For a self-signed upstream, point TEMPLATE_CA_BUNDLE at the CA PEM file,
# or (lab only) set TEMPLATE_VERIFY_SSL=false.
TEMPLATE_VERIFY_SSL=true
TEMPLATE_CA_BUNDLE=
