# Copy to prtg.env and fill in. Never commit real secrets.

# --- PRTG server (required) ---
# The PRTG base URL (HTTPS). No /api suffix.
PRTG_BASE_URL=https://prtg.example.com

# --- auth (pick ONE) ---
# Preferred: an API key (Setup -> Account Settings -> API Keys; PRTG 23.x+). "Read access" is enough
# for a read-only server; the opt-in writes need "Write access" (acknowledge_alarm alone works with
# "Acknowledge access"), and the key's user needs write access on the objects.
PRTG_API_TOKEN=
# Legacy fallback: username + passhash (get the hash from
#   /api/getpasshash.htm?username=<u>&password=<p>, or Account Settings -> Show Passhash).
# For writes this must be a read/write user with write access on the objects.
PRTG_USERNAME=
PRTG_PASSHASH=
# Or username + password instead of passhash (less preferred):
# PRTG_PASSWORD=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (pause_object, resume_object,
# acknowledge_alarm, scan_now). The API key / user needs write access on the objects (see auth above).
PRTG_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
PRTG_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# PRTG ships a self-signed cert by default. Point PRTG_CA_BUNDLE at the CA PEM,
# or (lab only) set PRTG_VERIFY_SSL=false.
PRTG_VERIFY_SSL=true
PRTG_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
PRTG_TIMEOUT=30
# Default row cap for list results (PRTG 'count'; capped at 5000 here).
PRTG_MAX_ROWS=200
