# Copy to netbox.env and fill in. Never commit real secrets.

# --- NetBox instance (required) ---
# The NetBox base URL (HTTPS). No /api suffix.
NETBOX_BASE_URL=https://netbox.example.com
# API token (user profile -> API Tokens). For a read-only server use a READ-ONLY token (uncheck
# "write enabled"). For writes the token must be write-enabled AND its user needs the object
# permissions (see README section 1).
# v1 token -> sent as "Token <token>"; v2 token "nbt_..." (NetBox 4.5+) -> sent as "Bearer".
NETBOX_TOKEN=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (create_ip_address,
# update_ip_address, assign_next_ip, update_device, add_journal_entry). Needs a write-enabled token
# whose user has ipam.add/change_ipaddress, dcim.change_device and extras.add_journalentry as needed.
NETBOX_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
NETBOX_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# For a self-signed / internal-CA instance, point NETBOX_CA_BUNDLE at the CA PEM,
# or (lab only) set NETBOX_VERIFY_SSL=false.
NETBOX_VERIFY_SSL=true
NETBOX_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
NETBOX_TIMEOUT=30
# Default page size for list results (limit; NetBox MAX_PAGE_SIZE caps at 1000).
NETBOX_MAX_ROWS=50
