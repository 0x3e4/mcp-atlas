# Copy to netbox.env and fill in. Never commit real secrets.

# --- NetBox instance (required) ---
# The NetBox base URL (HTTPS). No /api suffix.
NETBOX_BASE_URL=https://netbox.example.com
# API token (user profile -> API Tokens). For a read-only server use a READ-ONLY token (uncheck
# "write enabled"). For writes the token must be write-enabled AND its user needs the object
# permissions (see README section 1).
# v1 token -> sent as "Token <token>"; v2 token "nbt_..." (NetBox 4.5+) -> sent as "Bearer".
NETBOX_TOKEN=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (create_ip_address,
# update_ip_address, assign_next_ip, update_device, add_journal_entry). Needs a write-enabled token
# whose user has ipam.add/change_ipaddress, dcim.change_device and extras.add_journalentry as needed.
NETBOX_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
NETBOX_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# For a self-signed / internal-CA instance, point NETBOX_CA_BUNDLE at the CA PEM,
# or (lab only) set NETBOX_VERIFY_SSL=false.
NETBOX_VERIFY_SSL=true
NETBOX_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
NETBOX_TIMEOUT=30
# Default page size for list results (limit; NetBox MAX_PAGE_SIZE caps at 1000).
NETBOX_MAX_ROWS=50

# --- security (the same in every mcp-atlas server; see the repo README → Security) ---
# HTTP mode only: a bearer token clients / the gateway must send (Authorization: Bearer …). Or put it in a
# file (Docker secret) and set MCP_AUTH_TOKEN_FILE. Without it, anyone who reaches the port can call tools.
# MCP_AUTH_TOKEN=
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_token
# Credentials from files instead of this file (Docker / Kubernetes secrets): for any password, secret,
# token, API key or user variable set <VAR>_FILE to a file and leave <VAR> unset, e.g.
# NETBOX_TOKEN_FILE=/run/secrets/netbox_token
# The trailing newline is dropped; a missing or empty file, or both set differently, stops the server.
# HTTP mode only: Host header values clients use (DNS-rebinding protection), e.g. <container_name>:8000.
# MCP_ALLOWED_HOSTS=
# How writes are confirmed: auto (the client's dialog when it has one, else the confirm code), elicit (only
# the dialog), elicit-destructive (deletes / resets / merges only through the dialog), code (always the code).
MCP_CONFIRM_MODE=auto
# Offer only some tools (glob patterns, comma-separated), or hide some: MCP_TOOLS=list_*,get_* / MCP_DISABLED_TOOLS=delete_*
# MCP_TOOLS=
# MCP_DISABLED_TOOLS=
# Max executed writes per minute (0 = no limit).
MCP_WRITE_LIMIT=30
# Refuse writes whose arguments carry private keys, cloud / API tokens or this server's own credentials.
MCP_SECRET_SCAN=true
# Wrap text other people wrote (tickets, wiki pages, logs …) in <untrusted>…</untrusted> for the model.
MCP_MARK_UNTRUSTED=true
# Repeat that warning in every read tool's description (gateways such as mcpjungle drop server instructions).
MCP_DESCRIBE_UNTRUSTED=true
# Smaller tool list for the model (about 35 % fewer tokens): first paragraph of each description, compact
# schemas. Mostly useful for local models and gateways that pass every tool on.
MCP_COMPACT_TOOLS=false
# Audit log of every write: JSON lines on stderr (docker logs), GELF to Graylog, RFC 5424 syslog to any SIEM.
MCP_AUDIT_STDERR=true
# MCP_AUDIT_GELF=udp://graylog.example.com:12201        # or tcp://…
# MCP_AUDIT_SYSLOG=udp://siem.example.com:514           # or tcp://… / tls://…:6514 (RFC 5425)
# MCP_AUDIT_INSTANCE=                                  # label per instance / user, default: the host name
# MCP_AUDIT_READS=false                                # also log every read
