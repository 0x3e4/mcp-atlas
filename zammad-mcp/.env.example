# Copy to zammad.env and fill in. Never commit real secrets.

# --- Zammad instance (required) ---
# The Zammad base URL (HTTPS). No /api suffix.
ZAMMAD_BASE_URL=https://zammad.example.com
# API token (Profile -> Token Access). For writes the token needs ticket.agent permission.
ZAMMAD_TOKEN=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools
# (add_note, update_ticket, create_ticket, tag_ticket). Requires a token with ticket.agent permission.
ZAMMAD_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
ZAMMAD_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# For a self-signed / internal-CA instance, point ZAMMAD_CA_BUNDLE at the CA PEM,
# or (lab only) set ZAMMAD_VERIFY_SSL=false.
ZAMMAD_VERIFY_SSL=true
ZAMMAD_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
ZAMMAD_TIMEOUT=30
# Default page size for list results (per_page; capped at 200 here).
ZAMMAD_MAX_ROWS=50
