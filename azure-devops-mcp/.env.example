# Copy to azure-devops.env and fill in. Never commit real secrets.

# --- Azure DevOps Server (on-prem) — required ---
# The COLLECTION URL (HTTPS). On-prem includes the collection (and often a /tfs/ virtual dir).
# Examples: https://devops.contoso.com/DefaultCollection   |   https://devops.contoso.com/tfs/DefaultCollection
AZDO_BASE_URL=https://devops.contoso.com/DefaultCollection
# Personal Access Token with READ scopes (Code, Work Items, Build, Project & Team).
AZDO_PAT=

# --- api version (match your server) ---
# Azure DevOps Server 2019 -> 5.0 | 2020 -> 6.0 | 2022 -> 7.0 (2022.1 -> 7.1). TFS 2018 -> 4.1.
AZDO_API_VERSION=7.0

# --- scope ---
# Optional default project for project-scoped tools (so you can omit project=...).
AZDO_PROJECT=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the WRITE tools: work items (create, update,
# link, attach, restore), wiki pages (write, move), pull requests (open, edit, reviewers, comments) and
# branches (create). Requires a PAT with the matching write scopes (see README).
AZDO_ALLOW_WRITE=false
# Sensitive writes need their own switch ON TOP of AZDO_ALLOW_WRITE. All are read per instance env
# file, so they can be on for one user and off for another. "Always confirmed" = asks even with
# AZDO_CONFIRM_WRITE=false.
# Deletes: delete_work_items, delete_wiki_page, delete_branch (always confirmed). Deleting work items
# needs Work Items 'Read, write, & manage'.
AZDO_ALLOW_DELETE=false
# commit_files: push commits to branches (not the default branch). PAT: Code 'Read & write'.
AZDO_ALLOW_PUSH=false
# ... and to a repository's default branch too (always confirmed). Without it: branch + pull request.
AZDO_ALLOW_PUSH_DEFAULT_BRANCH=false
# complete_pull_request: merge now / set auto-complete (always confirmed).
AZDO_ALLOW_PR_MERGE=false
# complete_pull_request(bypass_policy=true): merge despite failing branch policies (always confirmed).
AZDO_ALLOW_POLICY_BYPASS=false
# vote_pull_request: approve / reject pull requests as the PAT's user.
AZDO_ALLOW_PR_VOTE=false
# queue_build / cancel_build. PAT: Build 'Read & execute'.
AZDO_ALLOW_PIPELINES=false
# create_release / deploy_release_stage (deploys always confirmed). PAT: Release 'Read, write, & execute'.
AZDO_ALLOW_RELEASES=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
AZDO_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# On-prem servers often use an internal CA. Point AZDO_CA_BUNDLE at the CA PEM,
# or (lab only) set AZDO_VERIFY_SSL=false.
AZDO_VERIFY_SSL=true
AZDO_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
AZDO_TIMEOUT=30
# Default row cap for shaped (non-full) list results.
AZDO_MAX_ROWS=200
