# Copy to audiocodes.env and fill in. Never commit real secrets.

# --- AudioCodes SBC (required) ---
# The device's web/REST address (HTTPS recommended). No /api/v1 suffix. For an HA pair, the
# active unit's (virtual) OAMP address.
AUDIOCODES_BASE_URL=https://sbc.example.com
# A device user (Local Users table) for HTTP Basic auth. Privilege level decides what works:
#   Monitor               status, alarms, KPIs, test call status
#   Administrator         + files list, license, save, reset, firmware, SIP recording
#   Security Administrator + configuration (CLI / INI read and change), show commands, TLS, license install
AUDIOCODES_USERNAME=
AUDIOCODES_PASSWORD=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true for: configuration changes (incremental CLI / INI,
# applied live without a reset), saving the configuration, SIP test calls, SIP recording control and
# certificate signing requests.
AUDIOCODES_ALLOW_WRITE=false
# Sensitive writes need their own switch ON TOP of AUDIOCODES_ALLOW_WRITE (per instance env file):
# Reset the device, replace the whole configuration (resets), upgrade firmware (resets). Always confirmed.
AUDIOCODES_ALLOW_RESET=false
# TLS: upload certificates, add trusted roots, generate a private key / self-signed certificate
# (the last two always confirmed).
AUDIOCODES_ALLOW_TLS=false
# Install a license key. Always confirmed.
AUDIOCODES_ALLOW_LICENSE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let the other write tools run directly.
AUDIOCODES_CONFIRM_WRITE=true
# Folder (inside the container) firmware .cmp files are read from for upgrade_firmware; mount it with
# -v /srv/sbc-firmware:/firmware:ro and set /firmware here. Empty = firmware upgrades off.
AUDIOCODES_FILE_DIR=

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# SBCs often use a self-signed or internal-CA certificate. Point AUDIOCODES_CA_BUNDLE at the CA PEM,
# or (lab only) set AUDIOCODES_VERIFY_SSL=false.
AUDIOCODES_VERIFY_SSL=true
AUDIOCODES_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds (configuration files and firmware uploads take a while).
AUDIOCODES_TIMEOUT=60
# Default row cap for list results.
AUDIOCODES_MAX_ROWS=200
