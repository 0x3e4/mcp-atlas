# Copy to netscaler-console.env and fill in. Never commit real secrets.

# --- NetScaler Console on-prem (formerly ADM) ---
# The Console's address (HTTPS). No /nitro suffix.
NETSCALER_CONSOLE_BASE_URL=https://console.example.com
# A Console user (System → User Administration). A read-only role is enough for every read tool;
# sent as X-NITRO-USER / X-NITRO-PASS on each request.
NETSCALER_CONSOLE_USERNAME=
NETSCALER_CONSOLE_PASSWORD=

# --- or: NetScaler Console service (cloud) ---
# Setting CUSTOMER_ID switches to the cloud service: a Citrix Cloud API client (Identity and Access
# Management → API Access) instead of the user above. BASE_URL then defaults to https://adm.cloud.com.
# NETSCALER_CONSOLE_CUSTOMER_ID=
# NETSCALER_CONSOLE_CLIENT_ID=
# NETSCALER_CONSOLE_CLIENT_SECRET=
# NETSCALER_CONSOLE_CLOUD_REGION=us        # us | eu | ap-s | jp

# --- ADC calls through the Console (API proxy) ---
# vserver_diagnose, waf_profile_status, instance_get, instance_running_config and set_entity_state reach
# one ADC through the Console. The Console uses its stored instance profile credentials; if it is set to
# prompt for instance credentials, give an ADC user here (read-only for the reads).
NETSCALER_CONSOLE_INSTANCE_USERNAME=
NETSCALER_CONSOLE_INSTANCE_PASSWORD=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true for: clearing active events and re-polling SSL
# certificates / configurations in the Console (nothing on the ADCs changes).
NETSCALER_CONSOLE_ALLOW_WRITE=false
# On top of ALLOW_WRITE: enable / disable services, servers, service groups (members) and vservers on
# an ADC through the Console (set_entity_state). Per instance env file, so it can be on for one user only.
NETSCALER_CONSOLE_ALLOW_INSTANCE_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
NETSCALER_CONSOLE_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# Point NETSCALER_CONSOLE_CA_BUNDLE at the CA PEM of the Console's certificate, or (lab only) set
# NETSCALER_CONSOLE_VERIFY_SSL=false.
NETSCALER_CONSOLE_VERIFY_SSL=true
NETSCALER_CONSOLE_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds (analytics queries over many instances can take a while).
NETSCALER_CONSOLE_TIMEOUT=60
# Row cap base for list results (tools cap at 5x this).
NETSCALER_CONSOLE_MAX_ROWS=200
