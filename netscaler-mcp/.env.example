# Copy to netscaler.env and fill in. Never commit real secrets.

# --- NetScaler ADC appliance (required) ---
# The appliance management URL: NSIP, or the HA management VIP / primary node IP. No /nitro suffix.
NETSCALER_BASE_URL=https://10.0.0.10
# A system user bound to the built-in 'readonlypolicy' command policy.
NETSCALER_USER=
NETSCALER_PASSWORD=

# --- WAF writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the AppFw WRITE tools (add/remove WAF rules,
# deploy/discard learned rules, set check actions, import/rehost profiles, save config). Every write
# tool previews by default (dry_run=true) and only touches the appliance when called with dry_run=false.
# Needs a system user whose command policy allows those appfw changes (see README), not readonlypolicy.
NETSCALER_ALLOW_WRITE=false

# --- WAF export/import files (optional) ---
# Directory inside the container where export_waf_profile saves (save_as=...) and import_waf_profile
# reads (file=...) JSON documents. Mount a volume here (see compose.yml.example). Leave empty and
# documents are only passed inline in tool calls/results.
NETSCALER_EXPORT_DIR=

# --- auth ---
# session (default): log in once, cache the NITRO_AUTH_TOKEN cookie, re-login on expiry.
# stateless: send X-NITRO-USER / X-NITRO-PASS on every request (no session slot held).
NETSCALER_AUTH_MODE=session
# Session lifetime (seconds) requested at login (session mode only).
NETSCALER_SESSION_TIMEOUT=900

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# Appliances ship self-signed certs. Point NETSCALER_CA_BUNDLE at the appliance CA PEM,
# or (lab only) set NETSCALER_VERIFY_SSL=false.
NETSCALER_VERIFY_SSL=true
NETSCALER_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
NETSCALER_TIMEOUT=30
# Default row cap for shaped (non-full) list results.
NETSCALER_MAX_ROWS=200
