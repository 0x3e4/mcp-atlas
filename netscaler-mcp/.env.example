# Copy to netscaler.env and fill in. Never commit real secrets.

# --- NetScaler ADC appliance (required) ---
# The appliance management URL: NSIP, or the HA management VIP / primary node IP. No /nitro suffix.
NETSCALER_BASE_URL=https://10.0.0.10
# A system user bound to the built-in 'readonlypolicy' command policy.
NETSCALER_USER=
NETSCALER_PASSWORD=

# --- several appliances in one server (optional) ---
# For appliances that are NOT one HA pair: standalone boxes, GSLB peers, separate HA pairs. List short
# names (letters, digits, '_', '-'), give each its own NETSCALER_<NAME>_BASE_URL ('-' becomes '_' in the
# variable name), and leave NETSCALER_BASE_URL above unset. Every appliance setting in this file
# (USER, PASSWORD, AUTH_MODE, SESSION_TIMEOUT, TIMEOUT, VERIFY_SSL, CA_BUNDLE, ALLOW_WRITE, ALLOW_DELETE, CONFIRM_WRITE,
# EXPORT_DIR) can be set per instance as NETSCALER_<NAME>_<KEY>; the plain NETSCALER_<KEY> is the shared
# fallback. Tools take instance=<name> (default: NETSCALER_DEFAULT_INSTANCE, else the first listed).
# NETSCALER_INSTANCES=dc1,dc2
# NETSCALER_DC1_BASE_URL=https://10.0.0.10
# NETSCALER_DC2_BASE_URL=https://10.0.1.10
# NETSCALER_DC2_USER=
# NETSCALER_DC2_PASSWORD=
# NETSCALER_DEFAULT_INSTANCE=dc1

# --- WAF / Bot writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the AppFw + Bot WRITE tools (add/remove WAF
# and bot rules, deploy/discard learned rules, set check actions and bot detections, import/rehost
# profiles, update signatures, save config). Every write tool previews by default (dry_run=true) and
# only touches the appliance when called with dry_run=false. Needs a system user whose command policy
# allows those appfw/bot changes (see README), not readonlypolicy.
NETSCALER_ALLOW_WRITE=false
# Deletes (delete_object: LB/CS vservers, services, service groups, servers, CS policies/actions,
# monitors) need this too, on top of NETSCALER_ALLOW_WRITE. They ALWAYS ask for confirmation, even
# with NETSCALER_CONFIRM_WRITE=false. The system user's command policy must allow the rm commands.
NETSCALER_ALLOW_DELETE=false
# Confirm before every write (default true): previews carry a confirm code, and dry_run=false only
# applies when called with that code, after the user confirmed the plan. false = dry_run=false applies directly.
NETSCALER_CONFIRM_WRITE=true
# Rule writes (WAF/Bot deploy, import, rehost, remove, state changes) in flight at once, 1-16
# (default 4; 1 = one after another).
NETSCALER_WRITE_CONCURRENCY=4
# Bind many WAF/Bot rules per request (NITRO bulk, falls back to single requests when rejected).
# Off by default: not yet tried on a live appliance.
NETSCALER_BULK_BIND=false

# --- WAF / Bot export/import files (optional) ---
# Directory inside the container where export_waf_profile / export_bot_profile save (save_as=...) and
# the matching import_*_profile tools read (file=...) JSON documents. Mount a volume here (see compose.yml.example). Leave empty and
# documents are only passed inline in tool calls/results.
NETSCALER_EXPORT_DIR=

# --- auth ---
# session (default): log in once, cache the NITRO_AUTH_TOKEN cookie, re-login on expiry.
# stateless: send X-NITRO-USER / X-NITRO-PASS on every request (no session slot held).
NETSCALER_AUTH_MODE=session
# Session lifetime (seconds) requested at login (session mode only).
NETSCALER_SESSION_TIMEOUT=900

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# Appliances ship self-signed certs. Point NETSCALER_CA_BUNDLE at the appliance CA PEM,
# or (lab only) set NETSCALER_VERIFY_SSL=false.
NETSCALER_VERIFY_SSL=true
NETSCALER_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
NETSCALER_TIMEOUT=30
# Default row cap for shaped (non-full) list results.
NETSCALER_MAX_ROWS=200

# --- security (the same in every mcp-atlas server; see the repo README → Security) ---
# HTTP mode only: a bearer token clients / the gateway must send (Authorization: Bearer …). Or put it in a
# file (Docker secret) and set MCP_AUTH_TOKEN_FILE. Without it, anyone who reaches the port can call tools.
# MCP_AUTH_TOKEN=
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_token
# Credentials from files instead of this file (Docker / Kubernetes secrets): for any password, secret,
# token, API key or user variable set <VAR>_FILE to a file and leave <VAR> unset, e.g.
# NETSCALER_PASSWORD_FILE=/run/secrets/netscaler_password
# The trailing newline is dropped; a missing or empty file, or both set differently, stops the server.
# HTTP mode only: Host header values clients use (DNS-rebinding protection), e.g. <container_name>:8000.
# MCP_ALLOWED_HOSTS=
# How writes are confirmed: auto (the client's dialog when it has one, else the confirm code), elicit (only
# the dialog), elicit-destructive (deletes / resets / merges only through the dialog), code (always the code).
MCP_CONFIRM_MODE=auto
# Offer only some tools (glob patterns, comma-separated), or hide some: MCP_TOOLS=list_*,get_* / MCP_DISABLED_TOOLS=delete_*
# MCP_TOOLS=
# MCP_DISABLED_TOOLS=
# Max executed writes per minute (0 = no limit).
MCP_WRITE_LIMIT=30
# Refuse writes whose arguments carry private keys, cloud / API tokens or this server's own credentials.
MCP_SECRET_SCAN=true
# Wrap text other people wrote (tickets, wiki pages, logs …) in <untrusted>…</untrusted> for the model.
MCP_MARK_UNTRUSTED=true
# Repeat that warning in every read tool's description (gateways such as mcpjungle drop server instructions).
MCP_DESCRIBE_UNTRUSTED=true
# Audit log of every write: JSON lines on stderr (docker logs), GELF to Graylog, RFC 5424 syslog to any SIEM.
MCP_AUDIT_STDERR=true
# MCP_AUDIT_GELF=udp://graylog.example.com:12201        # or tcp://…
# MCP_AUDIT_SYSLOG=udp://siem.example.com:514           # or tcp://… / tls://…:6514 (RFC 5425)
# MCP_AUDIT_INSTANCE=                                  # label per instance / user, default: the host name
# MCP_AUDIT_READS=false                                # also log every read
