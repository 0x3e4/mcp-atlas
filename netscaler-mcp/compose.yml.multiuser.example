# Several instances of netscaler-mcp from one image, each with its own env file — e.g. a shared
# read-only instance next to a write-enabled one with another account. Copy and customize locally:
#   cp compose.yml.multiuser.example compose.yml      # compose.yml is gitignored (per-deployment)
#   mkdir -p env && cp .env.example env/instance_a.env # instance a: its account + NETSCALER_ALLOW_WRITE=true
#   docker network create atlas-net                    # once; shared by the gateway + every server
#   docker compose pull && docker compose up -d
# Register each instance with the gateway under its own name:
#   mcpjungle register --name netscaler --url http://netscaler-mcp:8000/mcp
#   mcpjungle register --name netscaler-instance-a --url http://netscaler-mcp-instance-a:8000/mcp
# Writes still ask for confirmation first unless NETSCALER_CONFIRM_WRITE=false in that instance's env file.
# Images are built and pushed to GHCR by .github/workflows/build.yml.
# (No GHCR? Replace the image: line with "build: ." to build from this folder instead.)

# Shared settings. Compose ignores top-level x- keys; "<<:" merges shallowly, so an instance that sets
# its own environment: replaces this whole block — keep per-instance settings in its env file.
x-netscaler: &netscaler
  image: ghcr.io/0x3e4/netscaler-mcp:latest
  environment:
    MCP_TRANSPORT: streamable-http
    MCP_HOST: 0.0.0.0           # bind all interfaces (required for the gateway to reach it)
    MCP_PORT: "8000"            # every container listens on 8000 in its own namespace — no clash
  restart: unless-stopped
  networks: [atlas-net]         # no ports: — only the gateway reaches them, by container_name

services:
  netscaler-mcp:                    # existing shared read-only instance (NETSCALER_ALLOW_WRITE unset/false)
    <<: *netscaler
    container_name: netscaler-mcp
    env_file: ./netscaler.env

  netscaler-mcp-instance-a:         # write access with instance a's account (NETSCALER_ALLOW_WRITE=true)
    <<: *netscaler
    container_name: netscaler-mcp-instance-a
    env_file: ./env/instance_a.env
    # --- WAF export/import files: set NETSCALER_EXPORT_DIR=/exports in env/instance_a.env, then mount a
    #     host dir writable by the container user (uid 10001): mkdir exports && chown 10001 exports ---
    # volumes:
    #   - ./exports:/exports

  # Add more instances the same way: a new service name + container_name + env file.

networks:
  atlas-net:
    external: true
