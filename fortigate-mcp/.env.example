# Copy to fortigate.env and fill in. Never commit real secrets.

# --- FortiGate appliance (required) ---
# The management URL (HTTPS). No /api/v2 suffix. For an HA cluster, point at the management IP.
FORTIGATE_BASE_URL=https://192.0.2.1
# API token of a REST API admin whose access profile is read-only (see README) - or read-write
# on Firewall (address + policy) if you enable the write tools below.
FORTIGATE_API_TOKEN=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (create/update address
# objects, add/remove address-group members, enable/disable policies). The REST API admin then needs
# a read-write access profile for Firewall (at least address + policy) instead of read-only.
FORTIGATE_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
FORTIGATE_CONFIRM_WRITE=true

# --- scope ---
# VDOM to query by default ("root" on single-VDOM boxes). Tools can override per call.
FORTIGATE_VDOM=root

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# Appliances ship self-signed certs. Point FORTIGATE_CA_BUNDLE at the appliance CA PEM,
# or (lab only) set FORTIGATE_VERIFY_SSL=false.
FORTIGATE_VERIFY_SSL=true
FORTIGATE_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
FORTIGATE_TIMEOUT=30
# Default row cap for shaped (non-full) list results.
FORTIGATE_MAX_ROWS=200
