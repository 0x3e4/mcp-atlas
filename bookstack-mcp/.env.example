# Copy to bookstack.env and fill in. Never commit real secrets.

# --- BookStack instance (required) ---
# The BookStack base URL (HTTPS). No /api suffix.
BOOKSTACK_BASE_URL=https://docs.example.com
# API token of a user with the 'Access System API' permission (Profile -> API Tokens).
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (create/update pages,
# chapters, books and shelves; add_comment; attachments, images, drawings). The token's user needs the
# matching role permissions (images: "Create all images", attachments: "Create all attachments").
BOOKSTACK_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
BOOKSTACK_CONFIRM_WRITE=true

# --- draw.io drawings (optional) ---
# draw.io export server used by create_drawing / update_drawing to render diagrams to PNG
# (draw-image-export2 protocol, e.g. the jgraph/export-server sidecar in compose.yml.example).
# Leave empty to disable the drawing tools. Don't use a public export service: diagrams are sent there.
BOOKSTACK_DRAWIO_EXPORT_URL=

# --- file uploads from a drop folder (optional) ---
# Folder inside the container that upload_attachment / upload_image / update_* can read files from
# via path='...' (mount it with -v ~/bookstack-upload:/upload:ro). Leave empty to allow only text and
# base64 uploads. Paths can't leave this folder.
BOOKSTACK_UPLOAD_DIR=

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- TLS ---
# For a self-signed / internal-CA instance, point BOOKSTACK_CA_BUNDLE at the CA PEM,
# or (lab only) set BOOKSTACK_VERIFY_SSL=false.
BOOKSTACK_VERIFY_SSL=true
BOOKSTACK_CA_BUNDLE=

# --- advanced / optional ---
# httpx request timeout in seconds.
BOOKSTACK_TIMEOUT=30
# Default page size for list results (BookStack caps 'count' at 500).
BOOKSTACK_MAX_ROWS=100
