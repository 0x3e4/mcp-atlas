# Copy to defender.env and fill in. Never commit real secrets.

# --- Entra ID app registration (required) ---
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
# Only for DEFENDER_AUTH=app (ignored for delegated):
DEFENDER_CLIENT_SECRET=

# --- identity ---
# app (default): the server acts as the app registration (client credentials, application permissions).
# delegated: the server acts as YOU. Sign in once with `defender-mcp login` (device code) inside the
#   container; changes and comments then show your name and are limited by your Defender role. Needs
#   'Allow public client flows' = Yes and the Microsoft Graph DELEGATED permissions, admin-consented.
#   Run one container (and one token volume) per person, reachable only by that person.
DEFENDER_AUTH=app
# Where the delegated sign-in (refresh token) is kept. Mount a volume at its folder so it survives
# restarts; whoever can read this file can act as you.
# DEFENDER_TOKEN_CACHE=~/.defender-mcp/token.json

# --- writes (opt-in) ---
# Leave false for a read-only server. Set true to enable the write tools (update_incident,
# add_incident_comment, update_alert, add_alert_comment, create_case, update_case, add_case_comment,
# add_case_task, update_case_task). The app registration then also needs the Microsoft Graph
# permissions SecurityIncident.ReadWrite.All, SecurityAlert.ReadWrite.All and (cases)
# CaseManagement.ReadWrite.All, with admin consent granted.
DEFENDER_ALLOW_WRITE=false
# Ask before every write (default true): a write tool first returns a preview + confirm code and
# changes nothing; the agent shows you a short overview, asks "Confirm it?", and only then repeats
# the call with confirm=<code>. Set false to let write tools run directly.
DEFENDER_CONFIRM_WRITE=true

# --- transport ---
# stdio (default, for Claude Code) | streamable-http (always-on HTTP server)
# Optional - compose.yml sets these for the HTTP daemon (and overrides this file). Uncomment only for a manual docker-run HTTP server:
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- advanced / optional ---
# Switch to a Gov cloud by overriding these (and LOGIN_BASE_URL):
#   GRAPH_BASE_URL=https://graph.microsoft.us/v1.0
#   LOGIN_BASE_URL=https://login.microsoftonline.us
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
LOGIN_BASE_URL=https://login.microsoftonline.com

# httpx timeout in seconds (hunting queries can run up to ~3 minutes).
DEFENDER_TIMEOUT=180

# Default row cap for shaped (non-full) results.
DEFENDER_MAX_ROWS=200
